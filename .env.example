# Local Docker Compose values. Copy to .env and replace every password before
# sharing the environment beyond a single developer machine.
CORERANK_API_KEY=replace-with-a-random-local-api-key
CORERANK_REDIS_PORT=6379
CORERANK_MYSQL_ROOT_PASSWORD=replace-root-password
CORERANK_MYSQL_PASSWORD=replace-app-password
GF_SECURITY_ADMIN_PASSWORD=replace-grafana-password
